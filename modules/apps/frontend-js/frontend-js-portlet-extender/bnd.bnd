Bundle-Name: Liferay Frontend JS Portlet Extender
Bundle-SymbolicName: com.liferay.frontend.js.portlet.extender
Bundle-Version: 3.0.0
Liferay-JS-Submodules-Bridge: frontend-js-portlet-extender
Provide-Capability:\
	osgi.extender;\
		osgi.extender="liferay.frontend.js.portlet";\
		version:Version="1.1.0"
Web-ContextPath: /frontend-js-portlet-extender