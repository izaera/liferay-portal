{
	"liferay": {
		"dest-file-mapper": {
			"from": "(.*)\\.es\\.js$",
			"to": "$1.js"
		},
		"dest-mod-name-mapper": {
			"from": "(.*)\\.js$",
			"to": "bridge/frontend-js-portlet-extender/$1"
		},
		"file-globs": "**/*.js",
		"input": "classes/META-INF/resources",
		"output": "classes/META-INF/resources/bridge/frontend-js-portlet-extender",
		"src-mod-name-mapper": {
			"from": "(.*)\\.js$",
			"to": "frontend-js-portlet-extender/$1"
		}
	}
}