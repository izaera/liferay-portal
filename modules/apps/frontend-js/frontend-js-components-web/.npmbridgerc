{
    "frontend-js-components-web": {
        "dest-mod-name-mapper": {
            "from": "(.*)\\.js$",
            "to": "bridge/frontend-js-components-web/$1"
        },
        "file-globs": "**/*.js,!**/bridge",
        "input": "build/node/packageRunBuild/resources",
        "output": "build/node/packageRunBuild/resources/bridge/frontend-js-components-web",
        "src-mod-name-mapper": {
            "from": "(.*)\\.js$",
            "to": "frontend-js-components-web/$1"
        }
    }
}