{
	"csfConfig": {
		"path:**/*.js": {
			"js": {
				"lint": {
					"globals": {
						"$": true,
						"AlloyEditor": true,
						"CKEDITOR": true,
						"MODULE_PATH": true,
						"_": true
					}
				}
			}
		}
	},
	"dependencies": {
		"metal": "^2.16.5",
		"metal-component": "^2.16.3",
		"metal-debounce": "^2.0.0",
		"metal-dom": "^2.5.18",
		"metal-events": "^2.16.5",
		"metal-position": "^2.1.1",
		"metal-soy": "^2.13.2",
		"metal-state": "^2.13.2",
		"metal-uri": "^3.1.0"
	},
	"devDependencies": {
		"babel-cli": "6.26.0",
		"babel-preset-env": "^1.6.1",
		"check-source-formatting": "^2.0.4",
		"liferay-npm-bundler": "2.0.0-rc.4",
		"metal-tools-soy": "^4.2.1"
	},
	"name": "layout-admin-web",
	"scripts": {
		"build": "metalsoy --soyDeps 'node_modules/com.liferay.*/**/*.soy' && babel -d classes/META-INF/resources src/main/resources/META-INF/resources && liferay-npm-bundler",
		"checkFormat": "npm run csf",
		"csf": "csf src/**/*.js src/**/*.scss src/**/*.soy",
		"format": "npm run csf -- -i"
	},
	"version": "2.0.0"
}
