Bundle-Name: Liferay Dataset Taglib
Bundle-SymbolicName: com.liferay.dataset.taglib
Bundle-Version: 1.0.0
DynamicImport-Package: *
Export-Package:\
	com.liferay.dataset.taglib,\
	com.liferay.dataset.taglib.constants,\
	com.liferay.dataset.taglib.filter,\
	com.liferay.dataset.taglib.model,\
	com.liferay.dataset.taglib.provider,\
	com.liferay.dataset.taglib.servlet.taglib,\
	com.liferay.dataset.taglib.servlet.taglib.util,\
	com.liferay.dataset.taglib.view.cards,\
	com.liferay.dataset.taglib.view.list,\
	com.liferay.dataset.taglib.view.table,\
	com.liferay.dataset.taglib.view.table.selectable,\
	com.liferay.dataset.taglib.view.timeline
Provide-Capability:\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://liferay.com/tld/dataset";\
		version:Version="${Bundle-Version}"
Web-ContextPath: /dataset-taglib